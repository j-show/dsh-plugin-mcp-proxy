{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "declaration": true,
    "composite": true,
    "paths": {
      "@jshow/app-mcp-proxy": [
        "./packages/mcp-proxy/src/index.ts"
      ],
      "@jshow/app-mcp-proxy/*": [
        "./packages/mcp-proxy/src/*"
      ],
      "@jshow/app-mcp-proxy/protocol": [
        "./packages/mcp-proxy/modules/protocol/src/index.ts"
      ],
      "@jshow/app-mcp-proxy/protocol/*": [
        "./packages/mcp-proxy/modules/protocol/src/*"
      ],
      "@jshow/app-mcp-proxy/local": [
        "./packages/mcp-proxy/modules/local/src/index.ts"
      ],
      "@jshow/app-mcp-proxy/local/*": [
        "./packages/mcp-proxy/modules/local/src/*"
      ],
      "@jshow/app-mcp-proxy/runtime": [
        "./packages/mcp-proxy/modules/runtime/src/index.ts"
      ],
      "@jshow/app-mcp-proxy/runtime/*": [
        "./packages/mcp-proxy/modules/runtime/src/*"
      ],
      "@jshow/dsh-plugin-mcp-proxy": [
        "./packages/dsh-plugin/src/index.ts"
      ],
      "@jshow/app-mcp-proxy/runtime/desktop": [
        "./packages/mcp-proxy/modules/runtime/src/desktop.ts"
      ],
      "@jshow/app-mcp-proxy/runtime/startup": [
        "./packages/mcp-proxy/modules/runtime/src/startup.ts"
      ],
      "@jshow/app-mcp-proxy/protocol/activation": [
        "./packages/mcp-proxy/modules/protocol/src/activation.ts"
      ],
      "@jshow/app-mcp-proxy/local/management": [
        "./packages/mcp-proxy/modules/local/src/management.ts"
      ],
      "@jshow/app-mcp-proxy/runtime/package.json": [
        "./packages/mcp-proxy/package.json"
      ]
    },
    "types": [
      "node",
      "react"
    ]
  }
}
