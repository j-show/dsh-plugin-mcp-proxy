{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mcp-proxy",
  "version": "../../../package.json",
  "identifier": "io.github.jshow.mcp-proxy",
  "build": { "frontendDist": "../src/client" },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-src 'none'; object-src 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }, "nsis": { "installMode": "currentUser" } },
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
