{
  "name": "@j-show/mcp-proxy-runtime",
  "description": "Local mcp-proxy application runtime connecting configured MCP services to DSH",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0 AND MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j-show/dsh-plugin-mcp-proxy.git",
    "directory": "packages/mcp-proxy/modules/runtime"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./desktop": {
      "types": "./lib/types/desktop.d.ts",
      "default": "./lib/desktop.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "lib/mcp-proxy.exe",
    "lib/types/**/*.d.ts",
    "LICENSE-MIT-UPSTREAM",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2"
  },
  "dependencies": {
    "@deepseek-ai/dsh-util-values": "0.1.6-alpha.2",
    "@deepseek-ai/node-addon-system": "0.1.2",
    "@deepseek-ai/dsh-atomic-write": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-win32-process": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-cmdline": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-credentials-local": "0.1.6-alpha.2",
    "commander": "^15.0.0",
    "@j-show/mcp-proxy-protocol": "workspace:*",
    "@j-show/mcp-proxy-local": "workspace:*",
    "@deepseek-ai/dsh-credentials": "0.1.6-alpha.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/cordis-plugin-include": "1.0.7",
    "@deepseek-ai/dsh-app-boot": "0.1.6-alpha.2",
    "@types/ws": "^8.18.1",
    "koffi": "^3.1.0"
  },
  "private": true
}
