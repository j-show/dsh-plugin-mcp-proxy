{
  "name": "@j-show/dsh-plugin-mcp-proxy",
  "version": "0.1.0",
  "description": "Unified DSH installation and configuration entry for local MCP connectivity",
  "type": "module",
  "license": "Apache-2.0 AND MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j-show/dsh-plugin-mcp-proxy.git",
    "directory": "packages/dsh-plugin"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./protocol": {
      "types": "./lib/types/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./agent": {
      "types": "./lib/types/agent.d.ts",
      "default": "./lib/agent.js"
    },
    "./host": {
      "types": "./lib/types/host.d.ts",
      "default": "./lib/host.js"
    },
    "./browser": {
      "types": "./lib/types/browser.d.ts",
      "default": "./lib/browser.js"
    }
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "compat/*",
    "LICENSE-MIT-UPSTREAM",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3"
  },
  "dependencies": {
    "@j-show/dsh-mcp-proxy-host": "workspace:*",
    "@j-show/dsh-mcp-proxy-agent": "workspace:*",
    "@j-show/dsh-mcp-proxy-browser": "workspace:*",
    "@j-show/dsh-mcp-proxy-ui": "workspace:*",
    "@deepseek-ai/schemastery": "3.18.2",
    "@j-show/mcp-proxy-protocol": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  }
}
